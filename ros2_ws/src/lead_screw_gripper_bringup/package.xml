<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lead_screw_gripper_bringup</name>
  <version>0.0.0</version>
  <description>Runs the lead-screw gripper through ros2_control: robot description, controllers, launch file, and a fake Pico for testing without hardware</description>
  <maintainer email="anuragbhandari121@gmail.com">Anurag Bhandari</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lead_screw_gripper_description</exec_depend>
  <exec_depend>lead_screw_gripper_hardware</exec_depend>
  <exec_depend>lead_screw_gripper_kinematics</exec_depend>
  <exec_depend>parallel_gripper_controller</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-psutil</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
