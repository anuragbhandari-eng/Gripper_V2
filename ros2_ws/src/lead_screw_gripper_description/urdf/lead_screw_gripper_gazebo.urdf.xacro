<?xml version="1.0"?>
<robot name="lead_screw_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Simulation version of the gripper for Gazebo Harmonic with ros2_control.
       The full Onshape export, plus: a vertical lift joint so a grasp can be tested against
       gravity, box-shaped pads on the jaw faces (the only collision shapes), and every joint
       position-controlled. The linkage loops are not closed by the physics engine:
       the kinematics node sends every joint its exact value (phase 2 decision). -->
  <xacro:include filename="$(find lead_screw_gripper_description)/urdf/lead_screw_gripper_full.urdf.xacro"/>

  <!-- Mount: a rail fixed to the world (as in the gz_ros2_control cart demo), and base_link
       sliding up it, 50 mm above the ground at lift = 0. The lower limit sits below 0 on
       purpose: a joint that starts exactly on a limit stayed stuck there in Gazebo. -->
  <link name="world"/>
  <link name="lift_rail">
    <visual>
      <origin xyz="-0.125 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.2"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="world_to_rail" type="fixed">
    <parent link="world"/>
    <child link="lift_rail"/>
  </joint>
  <joint name="lift" type="prismatic">
    <parent link="lift_rail"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.04" upper="0.1" effort="100.0" velocity="0.2"/>
  </joint>

  <!-- Jaw pad: a 2 mm box whose outer face sits on the tooth tips of the jaw face
       (35.0 x 19.5 mm, measured from the exported finger mesh). Fixed joints get merged
       into the finger, so the pad becomes the finger's collision shape. -->
  <xacro:macro name="jaw_pad" params="side finger xyz rpy">
    <link name="jaw_pad_${side}">
      <collision>
        <geometry>
          <box size="0.03504 0.002 0.0195"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
      </inertial>
    </link>
    <joint name="jaw_pad_${side}_joint" type="fixed">
      <parent link="${finger}"/>
      <child link="jaw_pad_${side}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <gazebo reference="jaw_pad_${side}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:jaw_pad side="U" finger="finger_U_link" xyz="0.043661 0.053043 -0.006000" rpy="-3.141590 0 0.215532"/>
  <xacro:jaw_pad side="L" finger="finger_L_link" xyz="0.043661 -0.053043 -0.006000" rpy="-3.141590 0 -0.215532"/>

  <!-- ros2_control: every joint takes position commands -->
  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:position_joint name="lift"/>
    <xacro:position_joint name="bell_crank_U"/>
    <xacro:position_joint name="front_crank_U"/>
    <xacro:position_joint name="finger_U"/>
    <xacro:position_joint name="conrod_U"/>
    <xacro:position_joint name="bell_crank_L"/>
    <xacro:position_joint name="front_crank_L"/>
    <xacro:position_joint name="finger_L"/>
    <xacro:position_joint name="conrod_L"/>
    <xacro:position_joint name="carriage"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find lead_screw_gripper_description)/config/gripper_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
